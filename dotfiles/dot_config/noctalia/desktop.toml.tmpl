# Noctalia 5.2+: Tokyo Night / Omarchy sunset lake.
# GUI overrides in ~/.local/state/noctalia/settings.toml load LAST.
# See docs/niri-noctalia.md before applying for the first time.

[theme]
source = "custom"
custom_palette = "TokyoNight"
mode = "dark"
# 试玩壁纸驱动配色(Material You):把 source 改成 "wallpaper" 并加
# wallpaper_scheme = "m3-content"(还有 m3-tonal-spot / m3-rainbow / vibrant 等),
# 或运行时直接切换(写入 settings.toml,会覆盖这里的声明值):
#   noctalia msg color-scheme-set wallpaper m3-content
#   noctalia msg color-scheme-set custom TokyoNight   # 换回固定配色

# 主题模板:把 Noctalia 解析出的调色板渲染进外部应用配置。
# - alacritty: 生成 ~/.config/alacritty/themes/noctalia.toml(alacritty.toml 已 import,文件不存在时安静回退 rose-pine)
# - gtk3/gtk4: 生成 noctalia.css 并向 gtk.css 追加 @import(基础主题包 adw-gtk-theme 本机已装)
# starship / niri 模板会直接改写 chezmoi 管理的 live 配置文件,这里有意不启用,详见 docs/niri-noctalia.md。
[theme.templates]
enable_builtin_templates = true
builtin_ids = ["alacritty", "gtk3", "gtk4"]

[shell]
font_family = "Noto Sans"
corner_radius_scale = 1.0
setup_wizard_enabled = false
telemetry_enabled = false

[shell.animation]
enabled = true
speed = 1.15

[bar]
order = ["default"]

[bar.default]
position = "top"
margin_edge = 10
margin_ends = 12
thickness = 36
padding = 14
widget_spacing = 8
radius = 12
concave_edge_corners = false
background_opacity = 0.96
border = "outline"
border_width = 1.0
shadow = true
reserve_space = true
start = ["launcher", "workspaces"]
center = ["clock"]
end = ["media", "tray", "clipboard", "notifications", "network", "volume", "control-center", "session"]

[bar.default.monitor.portrait]
match = "HDMI-A-1"
margin_ends = 10
thickness = 34
padding = 10
widget_spacing = 6
start = ["launcher", "workspaces"]
center = ["clock"]
end = ["volume", "notifications", "control-center"]

[widget.clock]
type = "clock"
format = "{:%a  %m-%d  %H:%M}"

[widget.media]
max_length = 180.0

[dock]
enabled = false

[wallpaper]
enabled = true
# 自动轮换的浏览目录(每屏目录未覆盖时的回退,也是壁纸面板的默认目录)。
directory = "{{ .chezmoi.homeDir }}/.local/share/wallpapers/ezwallpaper-mocha/landscape"
fill_mode = "crop"
# 过渡效果池,每次切换随机抽取一种(5.2.x 支持这 6 种;新版还有 vortex/pixel/diamond/golden/melt)。
transition = ["fade", "wipe", "disc", "stripes", "zoom", "honeycomb"]
transition_duration = 900.0
transition_on_startup = true
fill_color = "surface"
# 每屏独立目录:主屏从 landscape/ 挑,竖屏从 portrait/ 挑,避免横图在竖屏上被中心裁切。
per_monitor_directories = true

[wallpaper.default]
path = "{{ .chezmoi.homeDir }}/.local/share/wallpapers/ezwallpaper-mocha/landscape/mocha-flat-landscape.png"

[wallpaper.monitors.DP-1]
path = "{{ .chezmoi.homeDir }}/.local/share/wallpapers/ezwallpaper-mocha/landscape/mocha-flat-landscape.png"

[wallpaper.monitors.HDMI-A-1]
path = "{{ .chezmoi.homeDir }}/.local/share/wallpapers/ezwallpaper-mocha/portrait/mocha-flat-portrait.png"

# 每屏轮换目录(automation 与壁纸面板都会用)。
[wallpaper.monitor.DP-1]
directory = "{{ .chezmoi.homeDir }}/.local/share/wallpapers/ezwallpaper-mocha/landscape"

[wallpaper.monitor.HDMI-A-1]
directory = "{{ .chezmoi.homeDir }}/.local/share/wallpapers/ezwallpaper-mocha/portrait"

# 自动换壁纸:启动时先挑一张,之后每 30 分钟换一张;两块屏各自独立轮换。
# 手动触发:noctalia msg wallpaper-random / wallpaper-next / wallpaper-previous
[wallpaper.automation]
enabled = false
interval_seconds = 1800
order = "random"
recursive = false

[backdrop]
enabled = true
blur_intensity = 0.6
tint_intensity = 0.35

[lockscreen]
enabled = true
blurred_desktop = false
blur_intensity = 0.25
tint_intensity = 0.35
lock_before_suspend = true
transition = ["fade"]
transition_duration = 900.0
# Empty wallpaper follows each output's own desktop wallpaper.
wallpaper = ""

[lockscreen_widgets]
enabled = true
schema_version = 2
widget_order = ["main-clock", "main-date", "portrait-clock", "portrait-date", "lockscreen-login-box@DP-1", "lockscreen-login-box@HDMI-A-1"]

[lockscreen_widgets.grid]
visible = false

[lockscreen_widgets.widget.main-clock]
type = "clock"
output = "DP-1"
cx = 1280.0
cy = 450.0
box_width = 640.0
box_height = 180.0
placement_width = 2560.0
placement_height = 1440.0

[lockscreen_widgets.widget.main-clock.settings]
format = "{:%H:%M}"
font_family = "Monaspace Neon NF"
color = "on_surface"
center_text = true
shadow = true

[lockscreen_widgets.widget.main-date]
type = "clock"
output = "DP-1"
cx = 1280.0
cy = 570.0
box_width = 420.0
box_height = 40.0
placement_width = 2560.0
placement_height = 1440.0

[lockscreen_widgets.widget.main-date.settings]
format = "{:%A · %Y-%m-%d}"
color = "on_surface"
center_text = true
shadow = true

[lockscreen_widgets.widget.portrait-clock]
type = "clock"
output = "HDMI-A-1"
cx = 540.0
cy = 650.0
box_width = 600.0
box_height = 160.0
placement_width = 1080.0
placement_height = 1920.0

[lockscreen_widgets.widget.portrait-clock.settings]
format = "{:%H:%M}"
font_family = "Monaspace Neon NF"
color = "on_surface"
center_text = true
shadow = true

[lockscreen_widgets.widget.portrait-date]
type = "clock"
output = "HDMI-A-1"
cx = 540.0
cy = 760.0
box_width = 420.0
box_height = 40.0
placement_width = 1080.0
placement_height = 1920.0

[lockscreen_widgets.widget.portrait-date.settings]
format = "{:%A · %Y-%m-%d}"
color = "on_surface"
center_text = true
shadow = true

[lockscreen_widgets.widget."lockscreen-login-box@DP-1"]
type = "login_box"
output = "DP-1"
enabled = true
cx = 1280.0
cy = 1120.0
box_width = 810.0
box_height = 196.0
placement_width = 2560.0
placement_height = 1440.0

[lockscreen_widgets.widget."lockscreen-login-box@DP-1".settings]
layout = "compact"
background_opacity = 0.9
background_radius = 16.0
input_radius = 10.0
show_weather = false
show_media = false
show_session_buttons = false
center_password_text = true

[lockscreen_widgets.widget."lockscreen-login-box@HDMI-A-1"]
type = "login_box"
output = "HDMI-A-1"
enabled = true
cx = 540.0
cy = 1560.0
box_width = 810.0
box_height = 196.0
placement_width = 1080.0
placement_height = 1920.0

[lockscreen_widgets.widget."lockscreen-login-box@HDMI-A-1".settings]
layout = "compact"
background_opacity = 0.9
background_radius = 16.0
input_radius = 10.0
show_weather = false
show_media = false
show_session_buttons = false
center_password_text = true
# Keep a password box on each output so unplugging the main screen is safe.

# 官方视频壁纸插件:mpvpaper 在 layer-shell 底层画视频,Noctalia 让出自己的壁纸层,
# 顶栏/停靠栏照常显示在视频之上;支持单视频与目录幻灯片,停止时自动提取静帧。
# 依赖系统包 mpvpaper + mpv(socat 可选,用于幻灯片状态跟踪):paru -S mpvpaper mpv socat
# 面板:noctalia msg panel-toggle noctalia/mpvpaper:picker
[plugins]
enabled = ["noctalia/mpvpaper"]

# 锁屏联动:锁屏时停掉 mpvpaper 并提取静帧,解锁后恢复播放;插件未加载时命令报错但不影响锁屏。
[hooks]
session_locked = ["noctalia msg plugin noctalia/mpvpaper:service all clear-all"]
session_unlocked = ["noctalia msg plugin noctalia/mpvpaper:service all reapply"]

[idle]
behavior_order = ["lock", "screen-off"]
pre_action_fade_seconds = 3.0

[idle.behavior.lock]
action = "lock"
enabled = true
timeout = 300.0

[idle.behavior.screen-off]
action = "screen_off"
enabled = true
timeout = 600.0

[idle.behavior.lock-and-suspend]
enabled = false

[notification]
follow_focused_output = true
width = 360
background_opacity = 0.96

[osd]
follow_focused_output = true
position = "top_center"

[weather]
enabled = false
