#!/bin/bash
# mise main config hash: {{ include "dot_config/mise.toml" | sha256sum }}
# mise sub config hash: {{ include "dot_config/mise/config.toml" | sha256sum }}

echo "检测到 Mise 配置变更，正在同步工具链..."

# 确保 mise 已在路径中（如果是第一次安装，可能需要指定绝对路径）
MISE=$HOME/.local/bin/mise
if [ ! -f "$MISE" ]; then
    curl https://mise.jdx.dev/install.sh | sh
fi

$MISE trust $HOME/.config/mise.toml

# 执行初始化任务：先安装基础语言，再安装衍生工具
# 使用显式的安装步骤而非 run bootstrap，防止全新的机器上由于 auto_install 触发全量预解析而失败
$MISE install -y go rust node python bun
$MISE install -y
